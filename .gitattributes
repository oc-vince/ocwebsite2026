# Normalise line endings for text so Windows checkouts don't churn the diff
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf
*.py     text eol=lf
*.md     text eol=lf
_redirects text eol=lf
robots.txt text eol=lf

# Binaries: never touch, and don't try to diff them
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.svg    text eol=lf
*.mp4    binary
*.pdf    binary
*.ico    binary
